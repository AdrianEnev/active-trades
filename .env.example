# Copy to .env in this repository or in its parent directory.
# Never commit real API credentials.

# Required: base Lighter account. Positions use public account reads.
LIGHTER_ACCOUNT_INDEX=

# Optional: authentication for base-account limit orders and stop-loss risk.
# Cancelling limit orders from the dashboard needs this API key pair, not a read-only token.
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
# A read-only token can be used instead of the API key pair.
LIGHTER_READ_ONLY_AUTH_TOKEN=
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai

# Optional: BingX perpetual positions and limit orders. Set both to enable.
# A read-only key is enough to read; cancelling orders needs perpetual futures trading permission.
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com

# Optional: TP/SL email alerts (Ctrl+E in the live dashboard). Same AWS SES
# SMTP variables as SFP, so a shared parent .env needs no changes.
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=
# One or more recipients, comma-separated.
ALERT_EMAIL_TO=

# Optional: comma-separated Lighter account indexes; skips wallet discovery.
LIGHTER_ACCOUNT_INDEXES=

# Optional: separate credentials for a Lighter sub-account. Replace 123.
# The API key pair is required to cancel that account's orders; a read-only token can only read.
LIGHTER_ACCOUNT_123_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_123_API_KEY_INDEX=
LIGHTER_ACCOUNT_123_READ_ONLY_AUTH_TOKEN=

# Full REST refresh interval for both exchanges, in seconds.
ACTIVE_TRADES_REFRESH_SECONDS=15
# Lighter live PNL display interval; minimum 0.5 seconds.
ACTIVE_TRADES_PNL_REFRESH_SECONDS=0.5
ACTIVE_TRADES_TIMEOUT_SECONDS=15
ACTIVE_TRADES_TRADE_LOOKBACK_LIMIT=100
ACTIVE_TRADES_AUTH_TOKEN_TTL_SECONDS=3600
# Optional override; defaults to state/position_state.json in this project.
ACTIVE_TRADES_STATE_PATH=

# Optional: Google Sheets trade journal. Leave disabled until remote access is set up.
ACTIVE_TRADES_JOURNAL_ENABLED=false
ACTIVE_TRADES_JOURNAL_SPREADSHEET=https://docs.google.com/spreadsheets/d/1OXRK3PwwuZ6nAYDpJDLAnMKQw0165ttemINsZLk3pjw/edit
ACTIVE_TRADES_JOURNAL_SHEET=Sheet1
# Absolute path to service-account JSON, stored outside the repository.
ACTIVE_TRADES_JOURNAL_CREDENTIALS=
ACTIVE_TRADES_JOURNAL_TIMEZONE=Europe/Sofia
# Fixed USD journal capital for Risk and Profit %. Blank keeps unknown percentages blank.
ACTIVE_TRADES_JOURNAL_CAPITAL=
# Initial history window; subsequent runs resume saved progress (including downtime).
ACTIVE_TRADES_JOURNAL_LOOKBACK_DAYS=30
# Classify a closed trade as BE when absolute realized P/L is <= this USD amount.
ACTIVE_TRADES_JOURNAL_BE_TOLERANCE=1
# Optional; defaults alongside position state to journal.sqlite3.
ACTIVE_TRADES_JOURNAL_STATE=
# Charts Exit stores links to generated PNGs hosted by qu.ax by default.
# No account, key, bucket or server needed; chart images are publicly readable.
# Optional: use your existing public Google Cloud Storage bucket instead of qu.ax.
# See docs/exit-chart-storage.md.
ACTIVE_TRADES_JOURNAL_CHART_BUCKET=
